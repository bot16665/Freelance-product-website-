# Copy this file to .env.local and fill it in.

# REQUIRED: Google accounts that are always store staff ("owners"). Comma separated.
# Owners can also give other people staff access from the Staff page.
OWNER_EMAILS=you@gmail.com

# Your Firebase project id (Firebase is only used for login). Default is already printer-sys.
FIREBASE_PROJECT_ID=printer-sys

# ---- Local development (leave these alone) ----
# Data lives in a plain SQLite file; backup = copy the whole ./data folder.
DATABASE_FILE=./data/store.db
UPLOAD_DIR=./data/uploads

# ---- Production (e.g. on Vercel) — set these in the Vercel dashboard ----
# Turso free database: turso db create <name>, then copy the URL and create a token.
# Leave DATABASE_URL empty locally to use the file above.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Vercel Blob (free image storage): created automatically when Blob is connected to
# your Vercel project. When set, uploaded images go to Blob instead of ./data/uploads.
BLOB_READ_WRITE_TOKEN=
