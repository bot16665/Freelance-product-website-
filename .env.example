# Copy this file to .env.local and fill it in.

# Turso database. Create one at https://turso.tech, then:
#   turso db create <name>
#   turso db show <name> --url      -> this is TURSO_DATABASE_URL
#   turso db tokens create <name>   -> this is TURSO_AUTH_TOKEN
# For local development you can leave TURSO_DATABASE_URL empty; the app then uses
# a local SQLite file (file:./data/dev.db) instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob stores the product images. On Vercel this token is added AUTOMATICALLY
# when you connect a Blob store to the project (Project -> Storage). Locally, run
# `vercel env pull .env.local` to fetch it.
# BLOB_READ_WRITE_TOKEN=

# REQUIRED: Google accounts that are always store staff ("owners"). Comma separated.
# Owners can also give other people staff access from the Staff page.
OWNER_EMAILS=you@gmail.com

# Your Firebase project id (Firebase is only used for login). Default is already printer-sys.
FIREBASE_PROJECT_ID=printer-sys
